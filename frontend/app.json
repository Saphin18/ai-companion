{
  "expo": {
    "name": "Saphin AI",
    "slug": "saphin-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2a2350"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saphin.ai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Saphin AI uses your microphone so you can send voice messages to your companion."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2a2350"
      },
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.saphin.ai",
      "googleServicesFile": "./google-services.json",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e8d6e6eb-b1bf-4e21-af8b-885612a4b999"
      }
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Saphin AI uses your microphone so you can send voice messages to your companion."
        }
      ]
    ]
  }
}
